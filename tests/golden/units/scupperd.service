# scupperd.service
[Unit]
Description=scupper reconciler
Wants=scupper-net.service network-online.target
After=scupper-net.service network-online.target
StartLimitIntervalSec=0
[Service]
Type=notify
WatchdogSec=30
Restart=always
RestartSec=2s
TimeoutStartSec=90
LimitCORE=0
# Keep the host mount namespace: restore_mount needs /run/netns propagation.
ExecStart=/usr/local/bin/scupperd
[Install]
WantedBy=multi-user.target
